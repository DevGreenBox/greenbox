# =============================================================================
# Caddy — «ЗелёнаяКоробка». РЕЖИМ БЕЗ ДОМЕНА (действует до переключения DNS)
# =============================================================================
# Сейчас A-запись greenboxweb.ru ведёт на старый хостинг (87.249.38.179), а не
# на этот сервер. Поэтому TLS здесь выключен:
#   • на IP-адрес Let's Encrypt сертификат не выпускает в принципе;
#   • на домен, который ещё указывает на чужой сервер, проверка HTTP-01 уйдёт
#     туда же и провалится — каждая попытка жжёт лимит неудачных валидаций
#     (5 в час на домен). Урок carre: такие попытки делают выпуск недоступным
#     как раз в тот момент, когда он понадобится.
#
# Сайт отдаётся по http://130.49.143.37 для приёмки. Блок — catch-all (:80),
# поэтому в ту же секунду, когда DNS переключат на этот сервер, домен начнёт
# работать по HTTP сам, без правки конфигурации: посетитель увидит сайт, а не
# ошибку Caddy «no such site».
#
# ПОСЛЕ ПЕРЕКЛЮЧЕНИЯ DNS включить HTTPS (обязателен: форма собирает
# персональные данные и согласие по 152-ФЗ):
#   cp /opt/greenbox/caddy/Caddyfile.domain-ready /opt/greenbox/caddy/Caddyfile
#   docker compose -f /opt/greenbox/docker-compose.yml up -d --force-recreate caddy
# Сертификат выпустится с первой попытки — DNS к этому моменту уже наш.
# =============================================================================

{
	# На IP сертификата быть не может, и попытки его получить бессмысленны.
	auto_https off
}

# -----------------------------------------------------------------------------
# Общие заголовки. HSTS здесь НЕТ намеренно: он заставил бы браузер ходить
# только по HTTPS, которого в этом режиме не существует, — и сайт стал бы
# недоступен до выпуска сертификата. HSTS включён в Caddyfile.domain-ready.
# -----------------------------------------------------------------------------
(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		# CSP — второй рубеж против XSS. Политика строгая, потому что сайту
		# нечего грузить со стороны: шрифты лежат в самом проекте
		# (src/app/fonts/*.woff2, self-hosted), внешних счётчиков нет,
		# яндекс-верификация — это мета-тег, а не скрипт, Telegram вызывается
		# только сервером (api.telegram.org из route.ts, не из браузера).
		#   script-src 'unsafe-inline' — инлайновые скрипты гидратации Next;
		#   style-src  'unsafe-inline' — критический CSS, который Next
		#              встраивает в <head>;
		#   img-src    data: — SVG-фон первого экрана рисуется в коде;
		#   frame-ancestors/object-src 'none' — iframe и <object> сайту не нужны.
		# 'unsafe-eval' НЕ разрешён: ни Next в production, ни GSAP его не требуют.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
	}
}

(json_log) {
	log {
		output stdout
		format json
	}
}

# -----------------------------------------------------------------------------
# Сайт: любой Host на порту 80 (IP для приёмки + домен сразу после смены DNS)
# -----------------------------------------------------------------------------
:80 {
	import security_headers
	import json_log

	# Приёмочный адрес по IP (и любое другое имя, кроме боевого домена) закрыт
	# от индексации: дубликат боевого сайта в поиске не нужен. Условие по Host,
	# а не на весь блок, — чтобы noindex случайно не уехал на greenboxweb.ru,
	# если DNS переключат раньше, чем включат HTTPS.
	@not_prod not host greenboxweb.ru www.greenboxweb.ru
	header @not_prod X-Robots-Tag "noindex, nofollow"

	# Фото кейсов, портреты команды и логотип лежат в public/ — хэша в имени
	# файла у них нет, поэтому долгий кэш недопустим: замена фото не создаст
	# новый URL, и браузеры показывали бы старое. Сутки — компромисс из handoff.
	# (У /_next/static/* хэш в имени есть, и годовой immutable Next ставит сам.)
	@public_media path /media/* /brand/*
	header @public_media Cache-Control "public, max-age=86400"

	# Тело запроса: сервер сам отвергает больше 16 КБ (MAX_BODY в
	# src/app/api/lead/route.ts), но отсекаем раньше, до Node. 64 КБ — запас
	# на служебные заголовки.
	@api path /api/*
	request_body @api {
		max_size 64KB
	}

	reverse_proxy app:3000 {
		# 🔴 ПЕРЕЗАПИСЬ, а не добавление в конец. /api/lead берёт ПЕРВЫЙ адрес
		# из X-Forwarded-For как IP заявителя для лимита 5 заявок/10 минут.
		# Если дописывать справа (поведение Caddy и nginx по умолчанию),
		# первым останется то, что прислал браузер, — подделать может любой,
		# и лимит на IP перестанет работать.
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Real-IP {http.request.remote.host}
	}
}
