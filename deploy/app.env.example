# Окружение сайта «ЗелёнаяКоробка» на сервере. Копия → /opt/greenbox/app.env,
# права 600 (в файле секрет бота). В git не попадает: см. .gitignore репозитория.

# Токен Telegram-бота для заявок (@BotFather).
# 🔴 Токен СТАРОГО бота опубликован в открытом виде на прежнем сайте
# (/assets/main-CLWkkBV4.js и /partner.html) — его нужно отозвать через
# @BotFather → /revoke и завести НОВЫЙ, а не переиспользовать.
# Пусто — заявки не уходят в Telegram, а пишутся в LEAD_LOG_PATH.
TELEGRAM_BOT_TOKEN=
# ID чата или группы, куда бот шлёт заявки квиза, формы и анкеты партнёра.
TELEGRAM_CHAT_ID=

# Email для Let's Encrypt (уведомления об истечении сертификата).
# Используется только в доменном режиме Caddy (Caddyfile.domain-ready).
ACME_EMAIL=
