# Скопируйте в .env.local (dev), задайте в окружении сервера или в настройках проекта Vercel
# (Settings → Environment Variables). Переменные читает только сервер.

# Токен Telegram-бота для заявок (от @BotFather). Пусто — заявки не уходят в Telegram, а пишутся в лог.
# На Vercel лог не сохраняется: без токена и chat_id форма отвечает ошибкой и ссылкой на Telegram студии.
TELEGRAM_BOT_TOKEN=
# ID чата или группы, куда бот присылает заявки.
TELEGRAM_CHAT_ID=
# Файл лога заявок (свой сервер). Пусто — ./leads.log от рабочей папки. На Vercel не используется.
LEAD_LOG_PATH=
